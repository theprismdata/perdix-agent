{
  "name": "perdix-vscode",
  "displayName": "Perdix",
  "version": "0.0.0",
  "private": true,
  "publisher": "perdix",
  "main": "./dist/extension.cjs",
  "engines": { "vscode": "^1.95.0" },
  "extensionKind": ["workspace"],
  "activationEvents": [],
  "contributes": {
    "commands": [{ "command": "perdix.open", "title": "Perdix: Open" }]
